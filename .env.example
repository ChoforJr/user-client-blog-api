# Used by server-rendered public API requests. This API is deployed separately.
BLOG_API_URL=https://your-blog-api.example.com

# Required for browser-side sign-in, account updates, and comments.
# Use the same API origin as BLOG_API_URL; this URL is public, not a secret.
NEXT_PUBLIC_BLOG_API_URL=https://your-blog-api.example.com
